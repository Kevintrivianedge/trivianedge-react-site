{
  "name": "trivianedge---next-gen-ai-&-global-talent-solutions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "[ -z \"$PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD\" ] && playwright install chromium || true",
    "build": "vite build && vite build --ssr entry-server.tsx --outDir dist-ssr && node scripts/agent-skills-index.mjs && node scripts/defer-css.mjs && node scripts/prerender.mjs && node scripts/llms-full.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "worker:dev": "wrangler dev",
    "generate-og": "node scripts/generate-og-image.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "seo:report": "node scripts/google-seo-report.mjs",
    "deploy": "npm run build && wrangler deploy",
    "postdeploy": "node scripts/indexnow-submit.mjs",
    "test:browsers": "playwright test -c playwright.prod.config.ts",
    "test:live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "framer-motion": "10.16.4",
    "lucide-react": "0.294.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "vanilla-cookieconsent": "^3.1.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "nanoid": "^3.3.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "beasties": "^0.5.4",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "playwright": "^1.60.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.2",
    "wrangler": "^4.0.0"
  },
  "browserslist": [
    "defaults",
    "Safari >= 14",
    "iOS >= 14",
    "Firefox ESR",
    "not dead"
  ]
}
